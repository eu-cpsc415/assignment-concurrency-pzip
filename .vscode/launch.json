{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pzip (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/pzip",
            "args": [
                "tests/base/6.in",
                ">",
                "out.bin"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build pzip",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}